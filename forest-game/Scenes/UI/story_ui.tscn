[node name="Story_UI" type="Node2D" unique_id=1092067955]
script = ExtResource("1_3pwli")
label_right_new_text = "  Schon wieder eins von den Viechern! Heute bin ich samt meiner Ausrüstung in den Wald nahe meines Heimatdorfes ... gezogen. Ich hielt es nicht mehr aus, andere Kinder glücklich mit ihren Müttern und Vätern zu sehen, während meinen Eltern gemeinsame Zeit mit ihrem Kind als verschwendet vorkam. Ich verabschiedete mich ein letztes Mal, und wie so oft ließen sie mich ohne Weiteres ziehen."
label_left_new_text = " Schon wieder eins von den Viechern. Heute bin ich samt meiner Ausrüstung in den Wald nahe meines Heimatdorfes ... gezogen. Ich hielt es nicht mehr aus, andere Kinder glücklich mit ihren Müttern und Vätern zu sehen, während meinen Eltern gemeinsame Zeit mit ihrem Kind als verschwendet vorkam. Ich verabschiedete mich ein letztes Mal, und wie so oft ließen sie mich ohne Weiteres ziehen."
book_texture = ExtResource("1_l581s")
new_title = " 2.10.1840 Tag 1 meiner Aufzeichnungen im Wald"

